# MedClaim Rx Environment Configuration Template
# Copy this file to .env and adjust values for your environment.

# Optional LLM Inference (e.g. Groq API for unlabelled prose extraction)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Local Vector Storage Path (ChromaDB)
CHROMA_PERSIST_DIR=.chroma

# Local SQLite Strong-Room Database Path
SQLITE_DB_PATH=data/medclaim.db

# Policy Handbook Source File
CLINICAL_POLICY_PATH=data/clinical_policy.md

# Observability and Audit Log Paths
LOGS_DIR=logs
AUDIT_LOG_FILE=logs/audit_traces.jsonl

# Clinical Thresholds (Defaults matching specification)
COST_GATE_INR=25000.0
CONF_GATE=0.80
